# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (region: Southeast Asia / Singapore, ap-southeast-1)
# Dashboard → Project Settings → API Keys. Legacy anon / service_role keys also work here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Used by seed/import scripts and trusted server code. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Demo admin account created by `npm run data:seed` (choose your own; do not reuse a real password)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

# OpenAI: dispatch copilot and Insights briefing (the rest of the app works without it)
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-6-luna
